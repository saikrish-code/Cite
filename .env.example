# ==============================================================================
# CiteRAG Configuration Environment Variables
# ==============================================================================

# General Application Settings
PROJECT_NAME="CiteRAG - Research Paper Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# .env.local for Next.js frontend

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# (Optional) Cohere API Key for reranking
COHERE_API_KEY="your_cohere_trial_key"

# Security & JWT
JWT_SECRET_KEY="supersecret-change-this-in-production-use-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relational Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="citerag"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/citerag"

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY="./chroma_data"
CHROMA_COLLECTION_NAME="citerag_chunks"
CHROMA_SERVER_HOST="localhost"
CHROMA_SERVER_PORT=8001

# Embeddings & Reranking Models
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# LLM Providers ("openai", "anthropic" / "claude", "ollama", or "mock")
LLM_PROVIDER="openai"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
ANTHROPIC_BASE_URL=""

# Ollama Configuration (Local Models)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

GEMINI_API_KEY=""
