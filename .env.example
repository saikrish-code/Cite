# ==============================================================================
# CiteRAG Configuration Environment Variables
# ==============================================================================

# General Application Settings
PROJECT_NAME="CiteRAG - Research Paper Assistant"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & JWT
JWT_SECRET_KEY="supersecret-change-this-in-production-use-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Relational Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword"
POSTGRES_DB="citerag"
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/citerag"

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY="./chroma_data"
CHROMA_SERVER_HOST="localhost"
CHROMA_SERVER_PORT=8001

# Embeddings & Reranking Models
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
RERANKER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"

# LLM Providers (Optional for local mocking / Required for live inference)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
